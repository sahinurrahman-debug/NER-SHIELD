POSTGRES_DB=ner_shield
POSTGRES_USER=ner_user
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://ner_user:change-this-local-password@localhost:5432/ner_shield
MODEL_PATH=/app/models/risk_model.joblib
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=8
CORS_ORIGINS=http://localhost:5173

# Optional: leave blank to run alerts in simulated mode (logged + stored, no real SMS sent).
# Fill in real Twilio credentials to actually dispatch SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated phone numbers in E.164 format, e.g. +919000000000,+919111111111
ALERT_SMS_RECIPIENTS=
# Minimum severity that triggers an alert: low | moderate | high | critical
ALERT_SEVERITY_THRESHOLD=high
# Don't re-alert the same district+severity combo within this many minutes
ALERT_COOLDOWN_MINUTES=15
# Alert SMS body includes one line per language, from: en, hi, as, bn
ALERT_LANGUAGES=en,hi,as,bn

# Optional: require this value as an X-API-Key header on POST /reports, /uploads, /predict.
# Leave blank to disable auth (fine for local/demo use).
API_KEY=

# Real-time monitoring job: rescoring risk cells on a timer using live data.
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=120
# open_meteo = real rainfall/soil-moisture via Open-Meteo (free, no key needed).
# simulated = random-walk fallback, useful for offline demos or testing.
WEATHER_PROVIDER=open_meteo
